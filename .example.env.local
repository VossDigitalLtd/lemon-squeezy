# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your Publishable key (sb_publishable_...)>
SUPABASE_SERVICE_ROLE_KEY=<your Secret key (sb_secret_...)>

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brand
NEXT_PUBLIC_APP_NAME=Admin
NEXT_PUBLIC_APP_DESCRIPTION=Admin Dashboard
# NEXT_PUBLIC_LOGO_PATH=/logo.svg                  # Full-width logo in /public. Displayed on auth pages & sidebar (expanded). Falls back to app name text.
# NEXT_PUBLIC_LOGO_DARK_PATH=/logo-dark.svg        # Dark mode variant of the full-width logo (optional). Falls back to NEXT_PUBLIC_LOGO_PATH.
# NEXT_PUBLIC_LOGO_ICON_PATH=/logo-icon.svg        # Square icon mark in /public. Displayed in sidebar, header & landing page. Falls back to first letter of app name.
# NEXT_PUBLIC_LOGO_ICON_DARK_PATH=/logo-icon-dark.svg  # Dark mode variant of the square icon (optional). Falls back to NEXT_PUBLIC_LOGO_ICON_PATH.

# External links (optional — uncomment and fill in as needed)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# NEXT_PUBLIC_HELP_URL=https://docs.example.com
# NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://example.com/terms

# ─── Feature flags ───────────────────────────────────────────────────────────
# Most features are OFF by default — set to 'true' to enable.
# Only 'developer' is ON by default — set to 'false' to disable.
# NEXT_PUBLIC_FEATURE_DEVELOPER=false          # Developer tools panel (super_admin only)
# NEXT_PUBLIC_FEATURE_SIGNUP=true              # Public self-registration (default: off — invite-only)

# Bolt-ons are OFF by default — set to 'true' to enable.
# See the BOLT-ON sections below for each feature's prerequisites.

# OAuth / Social login (disabled by default; set to 'true' to enable)
# Requires provider setup in Supabase Dashboard → Authentication → Providers
# For Vercel: add https://*.vercel.app/auth/callback to Supabase redirect URLs
# NEXT_PUBLIC_OAUTH_GOOGLE=true
# NEXT_PUBLIC_OAUTH_GITHUB=true
# NEXT_PUBLIC_OAUTH_MICROSOFT=true

# Routing
# NEXT_PUBLIC_HOME_REDIRECT=/login           # Redirect root '/' to this path instead of showing the landing page

# UI defaults
# NEXT_PUBLIC_DEFAULT_THEME=system           # light | dark | system
# NEXT_PUBLIC_DEFAULT_SIDEBAR_EXPANDED=true

# ─── BOLT-ON: Frontend ───────────────────────────────────────────────────────
# Public-facing homepage at '/'. Renders FrontendHeader (brand + theme toggle +
# auth state) and a content scaffold. Disable for private/admin-only apps where
# '/' should redirect to /login or /admin.
# NEXT_PUBLIC_FEATURE_FRONTEND=true

# ─── BOLT-ON: Account area ───────────────────────────────────────────────────
# Self-service account portal for role='user' end-customers: profile, security
# (password + 2FA), and data export/deletion. Not needed for private/staff-only apps.
# NEXT_PUBLIC_FEATURE_ACCOUNT=true

# ─── BOLT-ON: Audit Log ──────────────────────────────────────────────────────
# Admin panel audit trail — logs user management and profile events.
# No migration required (uses existing tables).
# NEXT_PUBLIC_FEATURE_AUDIT_LOG=true

# ─── BOLT-ON: Billing (Stripe) ───────────────────────────────────────────────
# Admin subscription management UI + Stripe. Run supabase/migrations/optional/008_billing.sql first.
# Get keys from: https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_FEATURE_BILLING=true
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...               # From: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...

# ─── BOLT-ON: Payments (Stripe one-time) ─────────────────────────────────────
# Stripe infrastructure for in-app one-time payments (product checkout, etc.).
# Does NOT show admin billing UI or nav link. Shares Stripe keys with Billing.
# Enable either or both flags independently.
# NEXT_PUBLIC_FEATURE_PAYMENTS=true
# (Stripe keys: see BILLING section above)

# ─── BOLT-ON: Email (Resend) ─────────────────────────────────────────────────
# Transactional email via Resend (workspace invites, etc.).
# Get API key from: https://resend.com/api-keys
# NEXT_PUBLIC_FEATURE_EMAIL=true
# RESEND_API_KEY=re_...
# NEXT_PUBLIC_EMAIL_FROM=noreply@yourdomain.com # Must be a verified domain in Resend

# ─── BOLT-ON: Onboarding ─────────────────────────────────────────────────────
# First-login onboarding flow for new admin users.
# Run supabase/migrations/optional/009_onboarding.sql first.
# NEXT_PUBLIC_FEATURE_ONBOARDING=true

# ─── BOLT-ON: Workspaces ─────────────────────────────────────────────────────
# Multi-tenant workspace/organisation support with invite-based membership.
# Run supabase/migrations/optional/010_workspaces.sql first.
# NEXT_PUBLIC_FEATURE_WORKSPACES=true
# NEXT_PUBLIC_WORKSPACE_LABEL=Workspace         # Rename to 'Organisation' or any other term

# ─── BOLT-ON: Support / Chat Widget ──────────────────────────────────────────
# Floating chat/support widget in the admin panel.
# See src/lib/support/SupportWidget.tsx for setup instructions and provider examples.
# NEXT_PUBLIC_FEATURE_SUPPORT=true
# NEXT_PUBLIC_SUPPORT_WIDGET_ID=your-widget-id  # Your provider's site/app/widget ID
# NEXT_PUBLIC_SUPPORT_WIDGET_LAUNCHER=true       # Set to 'false' to hide the floating bubble

# ─── BOLT-ON: Media Library ──────────────────────────────────────────────────
# Shared image library for uploading and picking reusable images.
# Run supabase/migrations/optional/011_media.sql first.
# NEXT_PUBLIC_FEATURE_MEDIA=true

# Error Monitoring (Sentry) — optional
# Get these from: https://sentry.io → Project → Settings → SDK Setup
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# SENTRY_AUTH_TOKEN=sntrys_...               # Required for source map uploads in CI
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
